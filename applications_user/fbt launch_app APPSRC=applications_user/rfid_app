#include <furi.h>
#include <furi_hal.h>
#include <furi_hal_rfid.h>
#include <notification/notification_messages.h>
#include <gui/gui.h>
#include <input/input.h>

#define TAG "RFID_App"

typedef enum {
    EventTypeTick,
    EventTypeKey,
} EventType;

typedef struct {
    bool is_running;
    bool data_ready;
    uint8_t data[64];
    NotificationApp* notification;
} RfidApp;

static void rfid_read_callback(void* context) {
    RfidApp* app = context;
    app->data_ready = true;
}

static void rfid_app_draw_callback(Canvas* canvas, void* context) {
    RfidApp* app = context;
    canvas_clear(canvas);
    canvas_set_font(canvas, FontPrimary);
    canvas_draw_str(canvas, 0, 10, "RFID Reader");

    if (app->data_ready) {
        canvas_draw_str(canvas, 0, 30, "Data Read:");
        char buffer[32];
        snprintf(buffer, sizeof(buffer), "%02X %02X %02X ...", app->data[0], app->data[1], app->data[2]);
        canvas_draw_str(canvas, 0, 50, buffer);
    } else {
        canvas_draw_str(canvas, 0, 30, "Scanning...");
    }
}

static void rfid_app_input_callback(InputEvent* input_event, void* context) {
    furi_assert(context);
    FuriMessageQueue* event_queue = context;

    furi_message_queue_put(event_queue, input_event, FuriWaitForever);
}
