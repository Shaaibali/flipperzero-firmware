#include <furi.h>
#include <furi_hal.h>
#include <furi_hal_rfid.h>
#include <notification/notification_messages.h>
#include <gui/gui.h>
#include <input/input.h>

#define TAG "RFID_App"

typedef enum {
    EventTypeTick,
    EventTypeKey,
} EventType;

typedef struct {
    bool is_running;
    bool data_ready;
    uint8_t data[64];
    NotificationApp* notification;
} RfidApp;

static void rfid_read_callback(void* context) {
    RfidApp* app = context;
    app->data_ready = true;
}

static void rfid_app_draw_callback(Canvas* canvas, void* context) {
    RfidApp* app = context;
    canvas_clear(canvas);
    canvas_set_font(canvas, FontPrimary);
    canvas_draw_str(canvas, 0, 10, "RFID Reader");

    if (app->data_ready) {
        canvas_draw_str(canvas, 0, 30, "Data Read:");
        char buffer[32];
        snprintf(buffer, sizeof(buffer), "%02X %02X %02X ...", app->data[0], app->data[1], app->data[2]);
        canvas_draw_str(canvas, 0, 50, buffer);
    } else {
        canvas_draw_str(canvas, 0, 30, "Scanning...");
    }
}

static void rfid_app_input_callback(InputEvent* input_event, void* context) {
    furi_assert(context);
    FuriMessageQueue* event_queue = context;

    furi_message_queue_put(event_queue, input_event, FuriWaitForever);
}

static void rfid_app_task(void* context) {
    RfidApp* app = context;

    // تهيئة RFID
    furi_hal_rfid_init();
    furi_hal_rfid_start_read();
    furi_hal_rfid_set_read_callback(rfid_read_callback, app);

    // تهيئة واجهة المستخدم
    ViewPort* view_port = view_port_alloc();
    view_port_draw_callback_set(view_port, rfid_app_draw_callback, app);
    view_port_input_callback_set(view_port, rfid_app_input_callback, app->notification);

    Gui* gui = furi_record_open(RECORD_GUI);
    gui_add_view_port(gui, view_port, GuiLayerFullscreen);

    // حلقة الأحداث
    InputEvent event;
    while (app->is_running) {
        if (furi_message_queue_get(app->notification, &event, 100) == FuriStatusOk) {
            if (event.type == EventTypeKey && event.key == InputKeyBack) {
                app->is_running = false;
            }
        }

        if (app->data_ready) {
            furi_hal_rfid_read(app->data, sizeof(app->data));
            FURI_LOG_I(TAG, "Data read: %02X %02X %02X ...", app->data[0], app->data[1], app->data[2]);
            app->data_ready = false;
        }

        view_port_update(view_port);
        furi_delay_ms(100);
    }

    // تنظيف الموارد
    furi_hal_rfid_stop_read();
    furi_hal_rfid_deinit();
    gui_remove_view_port(gui, view_port);
    view_port_free(view_port);
    furi_record_close(RECORD_GUI);
}

int32_t rfid_app(void* p) {
    RfidApp* app = malloc(sizeof(RfidApp));
    app->is_running = true;
    app->data_ready = false;
    app->notification = furi_record_open(RECORD_NOTIFICATION);

    FuriMessageQueue* event_queue = furi_message_queue_alloc(8, sizeof(InputEvent));

    rfid_app_task(app);

    furi_message_queue_free(event_queue);
    furi_record_close(RECORD_NOTIFICATION);
    free(app);

    return 0;
}